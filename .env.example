# =========================================================
# Smart Waste Management — Environment Variables Template
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to version control.
# =========================================================

# ---- OpenRouter AI (powers Prakriti AI Connect + all AI features) ----
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=ibm-granite/granite-3.1-8b-instruct

# ---- App security ----
APP_SECRET_KEY=change_this_to_a_long_random_string
SESSION_EXPIRY_MINUTES=60

# ---- Database ----
DATABASE_PATH=database/waste_management.db

# ---- App metadata ----
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_CITY=Gurugram
DEFAULT_MUNICIPAL_CORP=MCG

# ---- Optional: rate limiting ----
MAX_AI_REQUESTS_PER_MINUTE=20
